{
  "apphosting": {
    "backendId": "memohub",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "functions",
      ".firebase"
    ],
    "alwaysDeployFromSource": true
  },
  "hosting": {
    "public": ".next/standalone",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": "nextServer"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ],
  "firestore": {
    "indexes": "firestore/firestore.indexes.json"
  }
}
